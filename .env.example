# Copy to `.env` if you want to change anything. Every value has a working
# default — `docker compose up -d` works with no .env file at all.

# Host user that should own ./data. Find yours with: id -u && id -g
PUID=1000
PGID=1000

# Container timezone. Load-bearing: pay periods, payroll cutoff times, and bill
# due dates are all calendar arithmetic in this zone.
TZ=America/Chicago

# Host port to publish on.
PORT=3000

# Your public HTTPS origin, e.g. https://payroll.example.com
#
# Required before Web Push works on iOS. Apple only delivers push to a PWA that
# was installed from a valid HTTPS origin, and changing this later invalidates
# every existing subscription — so set it before onboarding phones.
APP_URL=

# Nightly SQLite snapshot: hour of day (0-23) and how long to keep them.
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=30
